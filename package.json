{
  "name": "debridge-de-challenge",
  "version": "1.0.0",
  "description": "DeBridge Finance Data Engineer Challenge - Cross-chain transaction ETL pipeline",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "worker": "ts-node-dev --respawn --transpile-only src/worker.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "init-db": "ts-node scripts/init-databases.ts",
    "load-mock-data": "ts-node scripts/load-mock-data.ts",
    "setup": "npm run init-db && npm run load-mock-data"
  },
  "keywords": [
    "debridge",
    "cross-chain",
    "etl",
    "temporal",
    "blockchain"
  ],
  "author": "DeBridge Finance",
  "license": "MIT",
  "dependencies": {
    "@clickhouse/client": "^0.2.5",
    "@fastify/cors": "^8.5.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@temporalio/activity": "^1.8.4",
    "@temporalio/client": "^1.8.4",
    "@temporalio/worker": "^1.8.4",
    "@temporalio/workflow": "^1.8.4",
    "axios": "^1.5.0",
    "dotenv": "^16.3.1",
    "fastify": "^4.29.1",
    "joi": "^17.9.2",
    "mongodb": "^6.1.0",
    "uuid": "^9.0.0",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@temporalio/testing": "^1.8.4",
    "@types/jest": "^29.5.4",
    "@types/node": "^20.19.11",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^9.0.2",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "@typescript-eslint/parser": "^6.4.0",
    "eslint": "^8.47.0",
    "jest": "^29.6.2",
    "mongodb-memory-server": "^9.1.1",
    "supertest": "^6.3.3",
    "testcontainers": "^10.2.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
